# Local vs hosted inference (local uses Ollama, hosted uses remote API)
GEMMA_MODE=local

# The local Ollama model to use (primary)
GEMMA_MODEL=gemma4:12b

# API key for the hosted Gemma endpoint (used only when GEMMA_MODE=hosted)
GEMMA_API_KEY=your_api_key_here

# Base URL for the hosted Gemma endpoint (used only when GEMMA_MODE=hosted)
GEMMA_API_BASE=https://api.your-provider.com/generate

# URL of the backend API for the Streamlit frontend to connect to (defaults to http://localhost:8000)
BACKEND_URL=http://localhost:8000
